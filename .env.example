# ============================================================
# Kurvenfunk Environment Configuration
# ============================================================
#
# Copy the required values into the environment-specific file:
#
#   .env.dev
#   .env.staging
#   .env.prod
#
# Never commit real secrets.
# ============================================================

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

APP_ENV=development
NODE_ENV=development

# ------------------------------------------------------------
# Public URLs
# ------------------------------------------------------------

WEB_URL=http://localhost:3000
API_URL=http://localhost:3101
AUTH_URL=http://localhost:3102

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_DB=kurvenfunk
POSTGRES_USER=kurvenfunk
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://kurvenfunk:CHANGE_ME@postgres:5432/kurvenfunk

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

REDIS_PASSWORD=change-me

# ------------------------------------------------------------
# Keycloak
# ------------------------------------------------------------

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Persistent Keycloak management account used by configuration scripts
KEYCLOAK_CONFIG_ADMIN_USERNAME=change-me
KEYCLOAK_CONFIG_ADMIN_PASSWORD=change-me

# ------------------------------------------------------------
# Meilisearch
# ------------------------------------------------------------

MEILI_MASTER_KEY=change-me

# ------------------------------------------------------------
# MinIO / Object Storage
# ------------------------------------------------------------

MINIO_ROOT_USER=kurvenfunk
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=kurvenfunk-media

# Application storage abstraction.
# DEV/STAGING use MinIO. Production can later use Cloudflare R2.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=kurvenfunk-media
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_FORCE_PATH_STYLE=true


# ------------------------------------------------------------
# Task 181 – IP pseudonymization (disabled until trusted ingress is verified)
# ------------------------------------------------------------
# Use a different, cryptographically random 32-byte key per environment.
# Generate locally with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
# Do NOT commit or paste generated values into logs, issues or chat.
# Leave unset while IP enforcement is disabled; do not use placeholders as keys.
IP_HASH_HMAC_SECRET=
IP_HASH_KEY_VERSION=v1
# Task 182: disabled until verified origin and Keycloak edge acceptance.
IP_RATE_LIMIT_ENABLED=false
# JSON map of previous key versions for finite rotation, e.g. {"v1":"<previous-secret>"}
# Remove a previous key only after no active blocks rely on it.
IP_HASH_PREVIOUS_KEYS_JSON=

# ------------------------------------------------------------
# Cloudflare
# ------------------------------------------------------------

CLOUDFLARE_TUNNEL_TOKEN=change-me
SWAGGER_ENABLED=false

# API authentication
KEYCLOAK_ISSUER=https://auth.example.com/realms/kurvenfunk
KEYCLOAK_JWKS_URL=https://auth.example.com/realms/kurvenfunk/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=kurvenfunk-api

# Task 176: dedicated service-account credentials for revoking banned-user sessions.
# Grant only realm-management/manage-users in the Kurvenfunk realm.
# These are placeholders; configure real per-environment credentials outside Git.
KEYCLOAK_ADMIN_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REVOKER_REALM=kurvenfunk
KEYCLOAK_REVOKER_CLIENT_ID=kurvenfunk-session-revoker
KEYCLOAK_REVOKER_CLIENT_SECRET=

# Transactional mail for Keycloak. DEV always uses internal Mailpit; never
# put a provider SMTP secret in Git or enable a public DEV mail relay.
# For STAGING / PROD set these in private .env.staging / .env.prod (0600).
# MAIL_TRANSPORT=smtp is mandatory outside DEV.
MAIL_TRANSPORT=
MAIL_FROM=no-reply@kurvenfunk.at
MAIL_FROM_NAME=KURVENFUNK
MAIL_REPLY_TO=no-reply@kurvenfunk.at
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_ENCRYPTION=
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# Microsoft 365 Exchange Online: select MAIL_TRANSPORT=microsoft365 in
# private STAGING/PROD .env only after Exchange Application RBAC is scoped
# to noreply@kurvenfunk.at. Do not assign tenant-wide Graph Mail.Send.
# Keycloak 26.6+ uses OAuth2 XOAUTH2, not a shared-mailbox password.
# MAIL_FROM=noreply@kurvenfunk.at
MAIL_M365_TENANT_ID=
MAIL_M365_CLIENT_ID=
MAIL_M365_CLIENT_SECRET=

# News import scheduler
NEWS_IMPORT_PROVIDER=fake
NEWS_IMPORT_SCHEDULER_ENABLED=false
NEWS_IMPORT_SCHEDULER_INTERVAL_MS=300000


# ------------------------------------------------------------
# News Provider
# ------------------------------------------------------------

NEWS_OTS_API_KEY=change-me
NEWS_OTS_API_BASE_URL=https://www.ots.at/api
NEWS_OTS_QUERY=Fußball
NEWS_OTS_PAGE_SIZE=20
NEWS_OTS_MAX_PAGES=5
NEWS_OTS_LOOKBACK_MINUTES=15
