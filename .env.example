# ============================================================
# Kurvenfunk Environment Configuration
# ============================================================
#
# Copy the required values into the environment-specific file:
#
#   .env.dev
#   .env.staging
#   .env.prod
#
# Never commit real secrets.
# ============================================================

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

APP_ENV=development
NODE_ENV=development

# ------------------------------------------------------------
# Public URLs
# ------------------------------------------------------------

WEB_URL=http://localhost:3000
API_URL=http://localhost:3101
AUTH_URL=http://localhost:3102

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_DB=kurvenfunk
POSTGRES_USER=kurvenfunk
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://kurvenfunk:CHANGE_ME@postgres:5432/kurvenfunk

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

REDIS_PASSWORD=change-me

# ------------------------------------------------------------
# Keycloak
# ------------------------------------------------------------

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Persistent Keycloak management account used by configuration scripts
KEYCLOAK_CONFIG_ADMIN_USERNAME=change-me
KEYCLOAK_CONFIG_ADMIN_PASSWORD=change-me

# ------------------------------------------------------------
# Meilisearch
# ------------------------------------------------------------

MEILI_MASTER_KEY=change-me

# ------------------------------------------------------------
# MinIO / Object Storage
# ------------------------------------------------------------

MINIO_ROOT_USER=kurvenfunk
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=kurvenfunk-media

# Application storage abstraction.
# DEV/STAGING use MinIO. Production can later use Cloudflare R2.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=kurvenfunk-media
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_FORCE_PATH_STYLE=true


# ------------------------------------------------------------
# Cloudflare
# ------------------------------------------------------------

CLOUDFLARE_TUNNEL_TOKEN=change-me
SWAGGER_ENABLED=false

# API authentication
KEYCLOAK_ISSUER=https://auth.example.com/realms/kurvenfunk
KEYCLOAK_JWKS_URL=https://auth.example.com/realms/kurvenfunk/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=kurvenfunk-api

# News import scheduler
NEWS_IMPORT_PROVIDER=fake
NEWS_IMPORT_SCHEDULER_ENABLED=false
NEWS_IMPORT_SCHEDULER_INTERVAL_MS=300000


# ------------------------------------------------------------
# News Provider
# ------------------------------------------------------------

NEWS_OTS_API_KEY=change-me
NEWS_OTS_API_BASE_URL=https://www.ots.at/api
NEWS_OTS_QUERY=Fußball
NEWS_OTS_PAGE_SIZE=20
NEWS_OTS_MAX_PAGES=5
NEWS_OTS_LOOKBACK_MINUTES=15
